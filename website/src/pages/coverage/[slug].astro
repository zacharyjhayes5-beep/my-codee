---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Button from '../../components/Button.astro';
import CoverageIcon from '../../components/CoverageIcon.astro';
import CTASection from '../../components/CTASection.astro';
import { coverage } from '../../data/coverage';
import { contact, site } from '../../config';

export const getStaticPaths = (() =>
  coverage.map((line) => ({
    params: { slug: line.slug },
    props: { line },
  }))) satisfies GetStaticPaths;

const { line } = Astro.props;
const others = coverage.filter((c) => c.slug !== line.slug);
---

<BaseLayout title={line.title} description={line.summary}>
  <!-- Page hero -->
  <section class="bg-brand-navy">
    <div class="container-page py-14 md:py-20">
      <nav aria-label="Breadcrumb" class="mb-6 text-sm text-white/60">
        <a class="hover:text-white" href="/coverage">Coverage</a>
        <span class="mx-2" aria-hidden="true">/</span>
        <span class="text-white/90">{line.title}</span>
      </nav>
      <span
        class="inline-flex h-12 w-12 items-center justify-center rounded-lg bg-white/10 text-brand-gold ring-1 ring-white/15"
      >
        <CoverageIcon name={line.icon} class="h-7 w-7" />
      </span>
      <h1 class="mt-6 max-w-3xl text-4xl font-semibold text-white md:text-5xl">
        {line.title}
      </h1>
      <p class="mt-5 max-w-2xl text-lg text-white/80">{line.intro}</p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <Button href={`/quote?coverage=${line.slug}`} size="lg">Get a quote</Button>
        <Button href={contact.calendarUrl} variant="ghost" size="lg" rel="noopener">
          Schedule a call
        </Button>
      </div>
    </div>
  </section>

  <!-- What it covers -->
  <Section tone="white">
    <SectionHeading
      eyebrow="What it covers"
      title="The pieces, in plain English"
      lead="Every policy is a stack of separate coverages. Here's what each part is actually doing."
    />
    <dl class="mt-10 grid gap-5 md:grid-cols-2">
      {
        line.covers.map((item) => (
          <div class="rounded-xl bg-sand p-6 ring-1 ring-line/70 md:p-8">
            <dt class="text-xl font-semibold text-brand-navy">{item.title}</dt>
            <dd class="mt-2 text-muted">{item.body}</dd>
          </div>
        ))
      }
    </dl>
  </Section>

  <!-- Who it's for -->
  <Section tone="green">
    <div class="grid gap-10 md:grid-cols-12">
      <div class="md:col-span-5">
        <SectionHeading eyebrow="Who it's for" title="You'll want this if&hellip;" />
      </div>
      <div class="md:col-span-7">
        <ul class="grid gap-4">
          {
            line.audience.map((a) => (
              <li class="flex gap-3 rounded-xl bg-white p-5 ring-1 ring-line/70">
                <svg
                  class="mt-0.5 h-6 w-6 shrink-0 text-brand-green"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="m5 12.5 4.5 4.5L19 7.5" />
                </svg>
                <span class="text-ink">{a}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </Section>

  <!-- Good to know -->
  <Section tone="white">
    <SectionHeading
      eyebrow="Good to know"
      title="Questions I get every week"
    />
    <div class="mt-10 grid max-w-3xl gap-4">
      {
        line.goodToKnow.map((item) => (
          <details class="group rounded-xl bg-sand p-6 ring-1 ring-line/70">
            <summary class="flex cursor-pointer list-none items-start justify-between gap-4 text-lg font-semibold text-brand-navy">
              {item.q}
              <span
                class="mt-1 shrink-0 text-brand-green transition-transform group-open:rotate-45"
                aria-hidden="true"
              >
                <svg
                  class="h-5 w-5"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                >
                  <path d="M12 5v14M5 12h14" />
                </svg>
              </span>
            </summary>
            <p class="mt-3 text-muted">{item.a}</p>
          </details>
        ))
      }
    </div>
    <p class="mt-8 max-w-3xl text-sm text-muted">
      This page is a plain-English summary, not a policy. Your actual coverage,
      limits, and exclusions are set by the policy documents {site.name} issues.
    </p>
  </Section>

  <!-- Other lines -->
  <Section tone="sand">
    <SectionHeading eyebrow="Also available" title="Other coverage" />
    <div class="mt-8 grid gap-4 sm:grid-cols-3">
      {
        others.map((c) => (
          <a
            href={`/coverage/${c.slug}`}
            class="flex items-center gap-3 rounded-xl bg-white p-5 ring-1 ring-line/70 transition-colors hover:ring-brand-green/40"
          >
            <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-brand-green-light text-brand-green">
              <CoverageIcon name={c.icon} class="h-5 w-5" />
            </span>
            <span class="font-semibold text-brand-navy">{c.title}</span>
          </a>
        ))
      }
    </div>
  </Section>

  <CTASection />
</BaseLayout>

<style>
  summary::-webkit-details-marker {
    display: none;
  }
</style>
