---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import Card from '../../components/Card.astro';
import CTASection from '../../components/CTASection.astro';
import { site } from '../../config';

const posts = (await getCollection('resources')).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);

const featured = posts.filter((p) => p.data.featured);
const rest = posts.filter((p) => !p.data.featured);

const fmt = (date: Date) =>
  date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
---

<BaseLayout
  title="Resources"
  description={`Short, plain-English guides to insurance in Michigan from ${site.name} — coverage basics, Michigan auto law, home gaps, and life insurance math.`}
>
  <Section tone="white">
    <div class="max-w-2xl">
      <p
        class="mb-3 text-sm font-semibold tracking-widest text-brand-green uppercase"
      >
        Resources
      </p>
      <h1 class="text-4xl font-semibold md:text-5xl">
        Short reads that make insurance make sense
      </h1>
      <p class="mt-5 text-lg text-muted">
        No fear-mongering, no filler. These are the explanations I find myself
        giving over and over, written down so you can read them at your own pace.
      </p>
    </div>

    {
      featured.length > 0 && (
        <div class="mt-12 grid gap-5 md:grid-cols-2">
          {featured.map((post) => (
            <Card href={`/resources/${post.id}`} class="flex flex-col">
              <div class="flex items-center gap-3 text-sm">
                <span class="rounded-full bg-brand-green-light px-3 py-1 font-semibold text-brand-green-dark">
                  {post.data.topic}
                </span>
                <span class="text-muted">{post.data.readingMinutes} min read</span>
              </div>
              <h2 class="mt-4 text-2xl font-semibold">{post.data.title}</h2>
              <p class="mt-3 grow text-muted">{post.data.description}</p>
              <p class="mt-5 font-semibold text-brand-green">
                Read it <span aria-hidden="true">&rarr;</span>
              </p>
            </Card>
          ))}
        </div>
      )
    }
  </Section>

  <Section tone="sand">
    <h2 class="text-2xl font-semibold">More reading</h2>
    <ul class="mt-8 grid gap-4">
      {
        rest.map((post) => (
          <li>
            <a
              href={`/resources/${post.id}`}
              class="group flex flex-col gap-2 rounded-xl bg-white p-6 ring-1 ring-line/70 transition-shadow hover:shadow-[0_8px_24px_rgba(18,38,63,0.08)] md:flex-row md:items-center md:gap-8 md:p-8"
            >
              <div class="grow">
                <div class="flex items-center gap-3 text-sm">
                  <span class="rounded-full bg-brand-green-light px-3 py-1 font-semibold text-brand-green-dark">
                    {post.data.topic}
                  </span>
                  <time datetime={post.data.publishedAt.toISOString()} class="text-muted">
                    {fmt(post.data.publishedAt)}
                  </time>
                </div>
                <h3 class="mt-3 text-xl font-semibold group-hover:text-brand-green">
                  {post.data.title}
                </h3>
                <p class="mt-2 max-w-prose text-muted">{post.data.description}</p>
              </div>
              <span class="shrink-0 text-sm font-semibold text-muted">
                {post.data.readingMinutes} min read
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </Section>

  <CTASection
    title="Have a question these didn't answer?"
    body="That's usually a sign it's specific to your situation — which is exactly the kind of question I like. Ask away."
  />
</BaseLayout>
