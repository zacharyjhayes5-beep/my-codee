---
import { nav, contact, site } from '../config';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---

<a
  href="#main"
  class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:m-3 focus:rounded-lg focus:bg-white focus:px-4 focus:py-2 focus:font-semibold focus:text-brand-navy focus:shadow"
>
  Skip to content
</a>

<header class="sticky top-0 z-40 border-b border-line bg-sand/95 backdrop-blur">
  <div class="container-page">
    <div class="flex h-16 items-center justify-between gap-4 md:h-20">
      <a href="/" class="flex items-center gap-3" aria-label={`${site.name} home`}>
        <span
          class="grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-brand-green font-heading text-lg font-semibold text-white"
          aria-hidden="true">H</span
        >
        <span class="leading-tight">
          <span class="block font-heading text-lg font-semibold text-brand-navy"
            >{site.name}</span
          >
          <span class="block text-xs text-muted">Farm Bureau Insurance</span>
        </span>
      </a>

      <nav class="hidden items-center gap-1 md:flex" aria-label="Main">
        {
          nav.map((item) => (
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class={`rounded-lg px-3 py-2 text-base font-medium transition-colors hover:text-brand-green ${
                isActive(item.href)
                  ? 'text-brand-green'
                  : 'text-ink'
              }`}
            >
              {item.label}
            </a>
          ))
        }
        <a
          href={contact.phoneHref}
          class="ml-2 rounded-lg px-3 py-2 text-base font-semibold text-brand-navy hover:text-brand-green"
        >
          {contact.phone}
        </a>
        <a
          href="/quote"
          class="ml-1 rounded-lg bg-brand-green px-4 py-2.5 font-semibold text-white transition-colors hover:bg-brand-green-dark"
        >
          Get a quote
        </a>
      </nav>

      <!-- Mobile: <details> gives us a working menu with no JavaScript. -->
      <details class="md:hidden" id="mobile-nav">
        <summary
          class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-lg ring-1 ring-line"
          aria-label="Toggle menu"
        >
          <svg
            class="h-6 w-6 text-brand-navy"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
        </summary>
        <div
          class="absolute inset-x-0 top-16 border-b border-line bg-sand p-5 shadow-lg"
        >
          <nav class="grid gap-1" aria-label="Mobile">
            {
              nav.map((item) => (
                <a
                  href={item.href}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                  class={`rounded-lg px-3 py-3 text-lg font-medium ${
                    isActive(item.href) ? 'text-brand-green' : 'text-ink'
                  }`}
                >
                  {item.label}
                </a>
              ))
            }
          </nav>
          <div class="mt-4 grid gap-3">
            <a
              href="/quote"
              class="rounded-lg bg-brand-green px-5 py-3.5 text-center text-lg font-semibold text-white"
              >Get a quote</a
            >
            <a
              href={contact.phoneHref}
              class="rounded-lg px-5 py-3.5 text-center text-lg font-semibold text-brand-navy ring-1 ring-line"
              >Call {contact.phone}</a
            >
          </div>
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  // ~10 lines of JS so the mobile menu closes on Escape or outside click.
  const menu = document.getElementById('mobile-nav') as HTMLDetailsElement | null;
  if (menu) {
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') menu.open = false;
    });
    document.addEventListener('click', (e) => {
      if (menu.open && !menu.contains(e.target as Node)) menu.open = false;
    });
  }
</script>

<style>
  summary::-webkit-details-marker {
    display: none;
  }
</style>
